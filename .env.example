# Copie para .env e preencha localmente. Nunca comite chaves.
AGENT_API_KEY=
# Opcional no loopback; obrigatório para acessar pela rede.
AGENT_ACCESS_TOKEN=
# Endpoint documentado do provedor; HTTPS remoto é obrigatório, HTTP só em loopback.
AGENT_BASE_URL=
AGENT_MODEL=
AGENT_HOST=127.0.0.1
AGENT_PORT=8765
AGENT_DB_PATH=data/ysha-agent.sqlite3
# Mensagens recentes enviadas ao modelo; o histórico completo permanece salvo.
AGENT_HISTORY_LIMIT=20
AGENT_SYSTEM_PROMPT="Você é Ysha Agente, um assistente útil, cuidadoso e objetivo. Peça confirmação antes de ações externas ou irreversíveis."

# Opcional: perfis múltiplos. Quando AGENT_PROVIDER_IDS estiver definido,
# esses perfis substituem AGENT_API_KEY, AGENT_BASE_URL e AGENT_MODEL acima.
# Guarde cada chave somente no .env local; deixe os exemplos abaixo sem credenciais.
# AGENT_PROVIDER_IDS=primary,backup
# AGENT_PROVIDER_SELECTED=primary
# AGENT_PROVIDER_FALLBACKS=backup
# AGENT_PROVIDER_TOTAL_TIMEOUT_SECONDS=90
# AGENT_PROVIDER_MAX_ATTEMPTS_PER_RESPONSE=8
# AGENT_PROVIDER_PRIMARY_TYPE=chat_completions
# AGENT_PROVIDER_PRIMARY_API_KEY=
# AGENT_PROVIDER_PRIMARY_BASE_URL=
# AGENT_PROVIDER_PRIMARY_MODEL=
# AGENT_PROVIDER_PRIMARY_TIMEOUT_SECONDS=30
# AGENT_PROVIDER_PRIMARY_MAX_RETRIES=1
# AGENT_PROVIDER_BACKUP_TYPE=chat_completions
# AGENT_PROVIDER_BACKUP_API_KEY=
# AGENT_PROVIDER_BACKUP_BASE_URL=
# AGENT_PROVIDER_BACKUP_MODEL=
# AGENT_PROVIDER_BACKUP_TIMEOUT_SECONDS=30
# AGENT_PROVIDER_BACKUP_MAX_RETRIES=1
